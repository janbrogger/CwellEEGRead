# Python virtual environment for Doorstop and the converter (recreate with ./setup.sh)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Session-start hook cache on Claude Code on the web (EEGLAB and dipfit checkouts)
.cache/

# Doorstop / editor scratch
docs/traceability/**/*.bak
.doorstop-cache/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Clinical test EEG data (real patients) lives only here and is never committed.
# Anonymised/synthetic test data may be committed under testdata/public/.
testdata/private/

# Doorstop HTML publish output (regenerate: doorstop publish all docs/traceability/published/html)
docs/traceability/published/html/
